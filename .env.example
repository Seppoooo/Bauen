# Kopiere diese Datei nach ".env" und trage deinen Schlüssel ein.
# Schlüssel gibt es unter https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional
JARVIS_NAME=Jarvis
JARVIS_WAKE_WORD=jarvis
JARVIS_ANREDE=Sir
JARVIS_SPRACHE=de-DE
JARVIS_MODEL=claude-opus-5-5
# low = schnell, medium/high = gründlicher aber langsamer
JARVIS_EFFORT=low
JARVIS_SPRECHTEMPO=185
